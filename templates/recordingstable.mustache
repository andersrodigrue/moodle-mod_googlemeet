{{!
  @template mod_googlemeet/recordingstable

  Example context (json):
  {
    "recordings": [
      {
        "id": 1,
        "name": "Weekly class",
        "createdtimeformatted": "Sunday, 23 April 2023, 1:47 PM",
        "duration": "1:00",
        "webviewlink": "https://drive.google.com/file/d/DriveFile_12345/view",
        "hasplayback": true,
        "visible": true
      }
    ],
    "hasrecordings": true,
    "coursemoduleid": 1919,
    "canedit": true,
    "canremove": true
  }
}}
<div
  id="googlemeet-recordings-{{coursemoduleid}}"
  class="googlemeet-recordings-table"
  data-region="recording-list"
>
  <h3 id="googlemeet-recordings-heading-{{coursemoduleid}}" class="h4">
    {{# str }} recordings, mod_googlemeet {{/ str }}
  </h3>
  <div class="table-responsive">
    <table class="table table-striped table-hover table-bordered">
      <thead>
        <tr>
          <th class="text-center" scope="col">{{# str }} recording, mod_googlemeet {{/ str }}</th>
          <th scope="col">{{# str }} name, mod_googlemeet {{/ str }}</th>
          <th scope="col">{{# str }} date, mod_googlemeet {{/ str }}</th>
          <th class="text-center" scope="col">{{# str }} duration, mod_googlemeet {{/ str }}</th>
          {{#canedit}}
            <th class="text-center" scope="col">{{# str }} visible, mod_googlemeet {{/ str }}</th>
          {{/canedit}}
        </tr>
      </thead>
      <tbody data-region="recording-rows">
        {{#recordings}}
          <tr
            data-region="recording-row"
            data-recording-id="{{id}}"
            {{^visible}}class="googlemeet-recording-hidden"{{/visible}}
          >
            <td class="text-center">
              {{#hasplayback}}
                <a
                  href="{{webviewlink}}"
                  class="btn btn-secondary btn-sm"
                  target="_blank"
                  rel="noopener"
                  aria-label="{{# str }} playrecording, mod_googlemeet {{/ str }}: {{name}}"
                >
                  {{# pix }} play, mod_googlemeet {{/ pix }}
                </a>
              {{/hasplayback}}
              {{^hasplayback}}
                <span class="text-muted">{{# str }} recordingplaybackunavailable, mod_googlemeet {{/ str }}</span>
              {{/hasplayback}}
            </td>
            <td>
              <div data-region="name-display">
                <span data-region="recording-name">{{name}}</span>
                {{#canedit}}
                  <button
                    type="button"
                    class="btn btn-link btn-sm p-1"
                    data-action="edit-name"
                    title="{{# str }} editrecordingname, mod_googlemeet {{/ str }}"
                    aria-label="{{# str }} editrecordingname, mod_googlemeet {{/ str }}"
                  >
                    {{# pix }} i/edit, core {{/ pix }}
                  </button>
                {{/canedit}}
              </div>
              {{#canedit}}
                <form data-region="name-form" hidden>
                  <label class="visually-hidden" for="googlemeet-recording-name-{{id}}">
                    {{# str }} recordingname, mod_googlemeet {{/ str }}
                  </label>
                  <div class="input-group">
                    <input
                      id="googlemeet-recording-name-{{id}}"
                      class="form-control"
                      type="text"
                      name="name"
                      value="{{name}}"
                      maxlength="255"
                      required
                    >
                    <button class="btn btn-primary" type="submit">
                      {{# str }} savechanges, core {{/ str }}
                    </button>
                    <button class="btn btn-secondary" type="button" data-action="cancel-name">
                      {{# str }} cancel, core {{/ str }}
                    </button>
                  </div>
                </form>
              {{/canedit}}
            </td>
            <td>{{createdtimeformatted}}</td>
            <td class="text-center">{{duration}}</td>
            {{#canedit}}
              <td class="text-center">
                <button
                  type="button"
                  class="btn btn-link btn-sm"
                  data-action="set-visibility"
                  data-visible="{{#visible}}0{{/visible}}{{^visible}}1{{/visible}}"
                >
                  <span data-region="visibility-label">
                    {{#visible}}{{# str }} hide, mod_googlemeet {{/ str }}{{/visible}}
                    {{^visible}}{{# str }} show, mod_googlemeet {{/ str }}{{/visible}}
                  </span>
                </button>
              </td>
            {{/canedit}}
          </tr>
        {{/recordings}}
        <tr data-region="empty-state" {{#hasrecordings}}hidden{{/hasrecordings}}>
          <td colspan="{{#canedit}}5{{/canedit}}{{^canedit}}4{{/canedit}}">
            {{# str }} thereisnorecordingtoshow, mod_googlemeet {{/ str }}
          </td>
        </tr>
      </tbody>
    </table>
  </div>
  {{#canremove}}
    <div class="mt-3" data-region="delete-container" {{^hasrecordings}}hidden{{/hasrecordings}}>
      <button type="button" class="btn btn-outline-danger" data-action="delete-recordings">
        {{# str }} deleterecordingreferences, mod_googlemeet {{/ str }}
      </button>
    </div>
  {{/canremove}}
</div>
